        {
          "name": "Create Recruiter",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Генерируем уникальный email на основе времени и случайного числа",
                  "const timestamp = Date.now();",
                  "const randomNum = Math.floor(Math.random() * 10000);",
                  "const uniqueEmail = `recruiter_${timestamp}_${randomNum}@hr-crm.com`;",
                  "",
                  "// Сохраняем в переменную коллекции",
                  "pm.collectionVariables.set('recruiter_email', uniqueEmail);",
                  "console.log('📧 Generated unique email:', uniqueEmail);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('admin_user_id', jsonData.id);",
                  "    console.log('✓ Created recruiter:', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"full_name\": \"Test Recruiter\",\n    \"email\": \"{{recruiter_email}}\",\n    \"role\": \"recruiter\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", ""]
            }
          }
        },
